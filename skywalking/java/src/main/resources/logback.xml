<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender only.
         The SkyWalking Java agent (injected by SWCK) intercepts log calls at JVM
         level via its apm-toolkit-logback-1.x-activation and forwards them to
         Satellite/OAP via gRPC automatically.
         No GRPCLogClientAppender needed — adding it causes ClassFormatError because
         the agent instruments the same class from the app JAR (duplicate field). -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%level] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="DEBUG">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>

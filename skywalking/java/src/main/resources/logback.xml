<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender with trace ID (per AGENT_INTEGRATION_GUIDE.md) -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.mdc.TraceIdMDCPatternLogbackLayout">
                <Pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{tid}] [%thread] %-5level %logger{36} - %msg%n</Pattern>
            </layout>
        </encoder>
    </appender>

    <!-- gRPC log reporter — sends logs to Satellite → OAP
         All log levels (DEBUG+) sent to SkyWalking UI
         Ref: AGENT_INTEGRATION_GUIDE.md Log Collection Setup (Java) -->
    <appender name="grpc-log" class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.log.GRPCLogClientAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.mdc.TraceIdMDCPatternLogbackLayout">
                <Pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{tid}] [%thread] %-5level %logger{36} - %msg%n</Pattern>
            </layout>
        </encoder>
    </appender>

    <!-- Async wrapper for non-blocking console logging -->
    <appender name="async-stdout" class="ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>0</discardingThreshold>
        <queueSize>1024</queueSize>
        <neverBlock>true</neverBlock>
        <appender-ref ref="STDOUT"/>
    </appender>

    <!-- Async wrapper for non-blocking gRPC logging -->
    <appender name="async-grpc-log" class="ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>0</discardingThreshold>
        <queueSize>1024</queueSize>
        <neverBlock>true</neverBlock>
        <appender-ref ref="grpc-log"/>
    </appender>

    <root level="DEBUG">
        <appender-ref ref="async-stdout"/>
        <appender-ref ref="async-grpc-log"/>
    </root>
</configuration>
